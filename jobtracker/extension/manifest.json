{
  "manifest_version": 3,
  "name": "JobTracker Capture",
  "version": "1.0.0",
  "description": "Captura os dados da vaga aberta e envia para a API do JobTracker.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobTracker Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}