# Copie este arquivo para .env e preencha com valores reais.
# NUNCA envie o .env para o repositório.

# ---------- PostgreSQL ----------
POSTGRES_DB=jobtracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ---------- JWT (HS256 exige chave com pelo menos 32 bytes) ----------
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# ---------- Criptografia local dos tokens OAuth (qualquer string forte; passa por SHA-256) ----------
ENCRYPTION_KEY=change-me-to-a-random-strong-secret

# ---------- Google OAuth (console.cloud.google.com -> credenciais OAuth) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback

# ---------- Sincronização automática do Gmail ----------
GMAIL_SYNC_ENABLED=true
GMAIL_SYNC_INITIAL_DELAY_MS=60000
GMAIL_SYNC_FIXED_DELAY_MS=3600000

# ---------- CORS (origens permitidas, separadas por vírgula; vazio = libera tudo) ----------
CORS_ALLOWED_ORIGINS=

# ---------- Perfil de execução (prod para deploy no Render) ----------
# SPRING_PROFILES_ACTIVE=prod